"""
SIH 26145 — Passive NDR Backend

Architecture:
  NetworkObservation
       │
       ├──► Deterministic Engine (all detectors in parallel)
       │
       └──► Feature Engine → ML Router (XGBoost + IsolationForest)
                │
                ▼
          Evidence Fusion
                │
                ▼
          Correlation Engine
                │
                ▼
          SecurityCase → MongoDB (async) + WebSocket broadcast

ML never blocks or replaces deterministic detection.
MongoDB failure never stops the data plane.
"""
import asyncio
import time
import logging
from datetime import datetime, timezone
from typing import List

from fastapi import FastAPI, BackgroundTasks, WebSocket, WebSocketDisconnect, HTTPException, Response
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import prometheus_client
from prometheus_client import Counter, Gauge, Histogram

from .schemas import Alert, SecurityCase
from .config import ENVIRONMENT, AppEnv
from .ingestion.scapy_adapter import ScapyAdapter
from .correlation import CorrelationEngine
from .ml.feature_engine import TumblingWindowFeatureEngine
from .ml.router import ModelRouter, EvidenceFusionEngine
from .repositories.mongo import MongoRepository
from .mcp_gateway import MCPOrchestrator

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# ── App ────────────────────────────────────────────────────────────────
app = FastAPI(title="SIH 26145 — Passive NDR Backend")

# Security & CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:3000"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.middleware("http")
async def add_security_headers(request, call_next):
    response = await call_next(request)
    response.headers["X-Content-Type-Options"] = "nosniff"
    response.headers["X-Frame-Options"] = "DENY"
    response.headers["Strict-Transport-Security"] = "max-age=31536000; includeSubDomains"
    return response

# ── Metrics ────────────────────────────────────────────────────────────
FLOWS_PROCESSED = Counter('ndr_flows_processed_total', 'Total network flows processed')
ALERTS_GENERATED = Counter('ndr_alerts_generated_total', 'Total alerts generated by fusion engine')
ML_INFERENCES = Counter('ndr_ml_inferences_total', 'Total ML inferences performed')
ACTIVE_CASES = Gauge('ndr_active_cases', 'Number of active security cases')

@app.get("/metrics")
async def get_metrics():
    """Prometheus-compatible metrics endpoint"""
    return Response(content=prometheus_client.generate_latest(), media_type="text/plain")

# ── Core Components ────────────────────────────────────────────────────
active_connections: List[WebSocket] = []
alert_queue: asyncio.Queue = asyncio.Queue()
correlation_engine = CorrelationEngine(max_cases=1000, max_alerts_per_case=50)
feature_engine = TumblingWindowFeatureEngine(window_size_ms=10000)
model_router = ModelRouter(model_dir="models")
fusion_engine = EvidenceFusionEngine()
mongo = MongoRepository()
mcp_orchestrator = MCPOrchestrator()

# ── Detectors ──────────────────────────────────────────────────────────
from backend.detectors.ddos import DDoSDetector
from backend.detectors.scan import PortScanDetector
from backend.detectors.beacon import BeaconingDetector
from backend.detectors.dga import DGADetector
from backend.detectors.dns_tunnel import DNSTunnelDetector
from backend.detectors.tls import TLSSessionDetector

detectors = [
    DDoSDetector(),
    PortScanDetector(),
    BeaconingDetector(),
    DGADetector(),
    DNSTunnelDetector(),
    TLSSessionDetector(),
]

# ── Telemetry ──────────────────────────────────────────────────────────
telemetry = {
    "total_alerts": 0,
    "total_flows": 0,
    "total_ml_inferences": 0,
    "total_feature_windows": 0,
    "start_time": time.time(),
}


# ── Alert Broadcasting ─────────────────────────────────────────────────
async def broadcast_alerts():
    """Reads alerts from the queue, correlates, persists, and broadcasts."""
    while True:
        alert: Alert = await alert_queue.get()
        telemetry["total_alerts"] += 1
        ALERTS_GENERATED.inc()

        # Correlate
        updated_case = correlation_engine.ingest_alert(alert)
        ACTIVE_CASES.set(len([c for c in correlation_engine.get_all_cases() if c.status == "OPEN"]))

        # Persist asynchronously (never blocks detection)
        try:
            await mongo.save_alert(alert.model_dump(mode="json"))
            if updated_case:
                await mongo.upsert_case(updated_case.model_dump(mode="json"))
        except Exception as e:
            logger.error("Persistence error (detection continues): %s", e)

        # Broadcast to WebSocket clients
        if active_connections:
            message = {
                "type": "NEW_ALERT",
                "alert": alert.model_dump(mode="json"),
                "case": updated_case.model_dump(mode="json") if updated_case else None,
            }
            dead = []
            for conn in active_connections:
                try:
                    await conn.send_json(message)
                except Exception:
                    dead.append(conn)
            for d in dead:
                if d in active_connections:
                    active_connections.remove(d)


# ── Kafka Consumer ─────────────────────────────────────────────────────
async def kafka_consumer_task():
    """Consumes live traffic from Kafka/Redpanda."""
    try:
        from backend.streaming.kafka_adapter import KafkaObservationConsumer
        consumer = KafkaObservationConsumer()
        if not consumer.enabled:
            logger.info("Kafka not available — live streaming disabled (PCAP replay still works)")
            return

        logger.info("Starting Kafka consumer...")
        loop = asyncio.get_running_loop()

        def _consume():
            for flow in consumer.consume():
                asyncio.run_coroutine_threadsafe(_process_flow(flow), loop)

        await loop.run_in_executor(None, _consume)
    except Exception as e:
        logger.warning("Kafka consumer failed: %s — detection continues via PCAP replay", e)


async def _process_flow(flow):
    """Process a single NetworkObservation through the full pipeline."""
    telemetry["total_flows"] += 1
    FLOWS_PROCESSED.inc()

    # 1. Deterministic detection (all detectors)
    det_alerts = []
    for detector in detectors:
        det_alerts.extend(detector.add_flow(flow))

    # 2. Feature extraction (tumbling window)
    feature_engine.ingest(flow)
    fv = feature_engine.extract_features(flow.source_ip, flow.timestamp)

    # 3. ML inference (independent of deterministic — runs in parallel conceptually)
    ml_pred = None
    if fv is not None:
        telemetry["total_feature_windows"] += 1
        ml_pred = model_router.evaluate(fv, flow)
        if ml_pred is not None:
            telemetry["total_ml_inferences"] += 1
            ML_INFERENCES.inc()
            # Persist ML prediction async
            try:
                await mongo.save_prediction(ml_pred.model_dump(mode="json"))
            except Exception:
                pass

    # 4. Evidence fusion
    final_alerts = fusion_engine.fuse(det_alerts, ml_pred, flow)

    # 5. Emit to correlation/broadcast queue
    for alert in final_alerts:
        await alert_queue.put(alert)


# ── PCAP Replay ────────────────────────────────────────────────────────
class ReplayRequest(BaseModel):
    filename: str


def process_pcap_background(filename: str, loop: asyncio.AbstractEventLoop):
    """Background thread: replay PCAP through the full pipeline."""
    logger.info("Starting PCAP replay: %s", filename)
    try:
        adapter = ScapyAdapter()
        for flow in adapter.consume(filename):
            telemetry["total_flows"] += 1
            FLOWS_PROCESSED.inc()

            # 1. Deterministic
            det_alerts = []
            for detector in detectors:
                det_alerts.extend(detector.add_flow(flow))

            # 2. Feature extraction
            feature_engine.ingest(flow)
            fv = feature_engine.extract_features(flow.source_ip, flow.timestamp)

            # 3. ML (runs regardless of deterministic result)
            ml_pred = None
            if fv is not None:
                telemetry["total_feature_windows"] += 1
                ml_pred = model_router.evaluate(fv, flow)
                if ml_pred is not None:
                    telemetry["total_ml_inferences"] += 1
                    ML_INFERENCES.inc()

            # 4. Evidence fusion
            final_alerts = fusion_engine.fuse(det_alerts, ml_pred, flow)

            for alert in final_alerts:
                asyncio.run_coroutine_threadsafe(alert_queue.put(alert), loop)

        # Flush detectors
        for detector in detectors:
            for alert in detector.flush():
                asyncio.run_coroutine_threadsafe(alert_queue.put(alert), loop)

    except Exception as e:
        logger.error("PCAP replay error: %s", e, exc_info=True)
    finally:
        logger.info("PCAP replay finished: %s", filename)


# ── Startup ────────────────────────────────────────────────────────────
@app.on_event("startup")
async def startup_event():
    asyncio.create_task(broadcast_alerts())
    asyncio.create_task(kafka_consumer_task())
    logger.info(
        "NDR Backend started in %s mode. XGB=%s  IForest=%s  MongoDB=%s",
        ENVIRONMENT.value,
        model_router.xgb_model is not None,
        model_router.iforest_model is not None,
        "checking"
    )

# ── API Routes ─────────────────────────────────────────────────────────
@app.get("/api/cases", response_model=List[SecurityCase])
async def get_cases():
    # If MongoDB is connected, get from Mongo
    cases = await mongo.get_active_cases()
    # Also fetch correlated ones in memory that haven't sync'd? No, get_all_cases gives active states 
    # but since correlation engine handles updates, we return the correlation engine cases because they are the live objects.
    # In production, we'd sync this. For this implementation we'll keep serving correlation_engine.get_all_cases() as the source of truth for UI speed.
    return correlation_engine.get_all_cases()


@app.get("/api/stats")
async def get_stats():
    cases = correlation_engine.get_all_cases()
    elapsed = max(time.time() - telemetry["start_time"], 1)
    return {
        "environment": ENVIRONMENT.value,
        "active_cases": len([c for c in cases if c.status == "OPEN"]),
        "critical_cases": len([c for c in cases if c.severity == "CRITICAL"]),
        "alerts_per_min": round(telemetry["total_alerts"] / (elapsed / 60), 2),
        "flows_processed": telemetry["total_flows"],
        "ml_inferences": telemetry["total_ml_inferences"],
        "feature_windows": telemetry["total_feature_windows"],
        "throughput_fps": round(telemetry["total_flows"] / elapsed, 1),
    }

@app.get("/health")
async def health_check():
    """Production health endpoint with component status."""
    mongo_health = await mongo.health()
    return {
        "status": "ok" if mongo_health.get("status") == "connected" else "degraded",
        "environment": ENVIRONMENT.value,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "components": {
            "detectors": len(detectors),
            "xgb_model": model_router.xgb_model is not None,
            "iforest_model": model_router.iforest_model is not None,
            "ml_stage": model_router.stage,
            "mongodb": mongo_health,
            "kafka": "check /api/stats for streaming status",
        },
        "telemetry": telemetry,
    }

@app.post("/replay")
async def start_replay(request: ReplayRequest, background_tasks: BackgroundTasks):
    if ENVIRONMENT == AppEnv.PRODUCTION:
        logger.error("SECURITY ALERT: Attempted to run PCAP replay in PRODUCTION mode")
        raise HTTPException(status_code=403, detail="PCAP replay is disabled in PRODUCTION mode")
        
    if not request.filename:
        raise HTTPException(status_code=400, detail="Filename is required")
    loop = asyncio.get_running_loop()
    background_tasks.add_task(process_pcap_background, request.filename, loop)
    return {"message": f"Replay started for {request.filename}"}


# ── MCP Routes ─────────────────────────────────────────────────────────
class EnrichRequest(BaseModel):
    indicators: dict
    analyst_id: str = "system"

@app.get("/api/mcp/tools")
async def list_mcp_tools():
    """List all registered MCP tools and their status."""
    return mcp_orchestrator.list_tools()

@app.post("/api/mcp/enrich")
async def enrich_indicators(request: EnrichRequest):
    """Run parallel MCP enrichment on provided indicators."""
    results = await mcp_orchestrator.enrich_indicators(
        request.indicators, 
        analyst_id=request.analyst_id
    )
    # Log executions to MongoDB async
    for res in results:
        asyncio.create_task(mongo.save_mcp_execution(res.to_evidence_dict()))
        
    return [r.to_evidence_dict() for r in results]


@app.websocket("/alerts")
async def websocket_alerts(websocket: WebSocket):
    await websocket.accept()
    active_connections.append(websocket)
    logger.info("WebSocket client connected.")
    try:
        while True:
            await websocket.receive_text()
    except WebSocketDisconnect:
        logger.info("WebSocket client disconnected.")
    except Exception as e:
        logger.error("WebSocket error: %s", e)
    finally:
        if websocket in active_connections:
            active_connections.remove(websocket)


if __name__ == "__main__":
    import uvicorn
    uvicorn.run("backend.main:app", host="127.0.0.1", port=8000, reload=True)
