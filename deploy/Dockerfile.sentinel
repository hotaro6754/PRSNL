# Sentinel-26145 detection engine + API.
# The image has no packet-transmit capability and runs as an unprivileged user.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY deploy/requirements-sentinel.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY sentinel/ ./sentinel/
COPY models/dga/ ./models/dga/
COPY ml/evaluate.py ml/benchmark.py ./ml/

RUN useradd --system --uid 10001 --home /var/lib/sentinel sentinel \
    && mkdir -p /var/lib/sentinel/captures /app/results \
    && chown -R sentinel:sentinel /var/lib/sentinel /app/results

USER sentinel
ENV SENTINEL_DATA_DIR=/var/lib/sentinel \
    SENTINEL_CAPTURE_DIR=/var/lib/sentinel/captures

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=2).status == 200 else 1)"
CMD ["uvicorn", "sentinel.api:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
